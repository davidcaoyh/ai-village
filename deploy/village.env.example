# Copy to /etc/village.env on the server, then: chmod 600 /etc/village.env
# systemd reads this file for both units. It is the only place secrets live on
# the box - never in the repo, never in a unit file (unit files are world-readable).

OPENROUTER_API_KEY=sk-or-v1-...
TAVILY_API_KEY=tvly-...

# Absolute, not relative: systemd services do not run from the directory you
# think they do, and two units pointing at two different SQLite files is a
# failure that looks exactly like "the website shows nothing".
VILLAGE_DB_PATH=/opt/village/runs/village.db

# The code-side rails. The account-side rail lives in the OpenRouter dashboard
# and is the one a bug in this repo cannot switch off.
VILLAGE_MAX_TURNS=120
VILLAGE_MAX_USD=2.00

# Required on a public host: gates POST /api/stop (D28). Generate with
#   openssl rand -hex 24
VILLAGE_ADMIN_TOKEN=change-me
