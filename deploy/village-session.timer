# Back-to-back sessions, so the site is live when someone opens it.
#
# OnUnitInactiveSec, not OnCalendar: the service is Type=oneshot, and a calendar
# timer would fire while a session was still running. This one starts counting when
# the last run *finished*, so two sessions can never overlap.
#
# Before enabling this, run one session by hand and read the transcript, and set
# VILLAGE_MAX_USD_PER_DAY - an unattended loop with only a per-session cap has no
# ceiling on the day (D45).

[Unit]
Description=AI Village session, restarted after each one ends

[Timer]
OnUnitInactiveSec=5min
OnBootSec=2min
# Missed while the machine was down: start once it is back rather than waiting out
# the full interval.
Persistent=true
# Four villagers all starting on the same minute as everyone else's cron is how
# you meet a provider rate limit. Spread it.
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
