# Copy to .env for local runs. On the server this file is /etc/village.env, mode 600.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Free tier at tavily.com. Without it search falls back to keyless
# DuckDuckGo, which is rate-limited and will thin out over a long session.
# An unedited placeholder counts as unset, so leaving this line alone is safe.
TAVILY_API_KEY=tvly-...

VILLAGE_DB_PATH=runs/village.db

# The code-side rails. The account-side rail is the credit limit in the
# OpenRouter dashboard, which a bug in this repo cannot switch off.
VILLAGE_MAX_TURNS=120
VILLAGE_MAX_USD=2.00

# Gates POST /api/stop. Empty is right on a laptop and wrong on a public host.
# Generate with: openssl rand -hex 24
VILLAGE_ADMIN_TOKEN=
